<view class="page"><text class="h1">每一轮都留着</text><text class="subtitle mb">共 {{total}} 轮 · 点击查看票数、备注和投票成员</text><view class="stack"><button wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="row between"><text class="h3">{{item.title}}</text><text class="badge">{{item.label}}</text></view><review-time labelPrefix="发起于" value="{{item.createdAt}}" /><text class="subtitle">{{item.initiatorName}} · {{item.participantCount}} 人参与</text><text wx:if="{{item.winner}}">获胜：{{item.winner}}</text><text wx:if="{{item.addedItem}}" class="subtitle">已加入 {{item.addedItem.menuDate}} 菜单</text></button><text wx:if="{{!total && !loading}}">还没有投票记录</text><text class="small muted">{{loading ? '正在加载…' : cursor ? '继续下滑加载' : '已全部显示'}}</text></view></view>