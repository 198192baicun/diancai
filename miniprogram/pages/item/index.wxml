<view class="page" wx:if="{{item}}">
  <view class="row between mb"><text class="badge {{item.status}}">{{statusLabel}}</text><text class="small muted">{{item.menuDate}}</text></view>
  <text class="h1">{{item.dishName}}</text><photo-gallery wx:if="{{item.coverMediaId}}" ids="{{[item.coverMediaId]}}" />
  <view class="meta-grid"><text class="meta-label">点菜人</text><text>{{item.orderedName}}</text><text class="meta-label">做菜人</text><text>{{item.cookName || '等待认领'}}</text><text class="meta-label">本次备注</text><text>{{item.note || '没有特别要求'}}</text><block wx:if="{{item.status === 'cancelled'}}"><text class="meta-label">取消人</text><text>{{item.cancelledName}}</text><text class="meta-label">取消说明</text><text>{{item.cancelReason || '未填写原因'}}</text></block></view>
  <view wx:if="{{isPast}}" class="note">这是往日事项。继续处理不会改变原来的菜单日期。</view>
  <view class="section-head"><text class="h2">当前做法</text><button class="btn-text" bindtap="openDish">菜品资料 ›</button></view>
  <view class="card">
    <view wx:for="{{steps}}" wx:key="id" class="step"><text class="step-number">{{index + 1}}</text><view class="grow"><text>{{item.content}}</text><image wx:if="{{item.mediaURL}}" class="step-image mt-sm" src="{{item.mediaURL}}" data-src="{{item.mediaURL}}" bindtap="previewImage" mode="widthFix" /><text wx:if="{{item.mediaDownloadOnly}}" class="small muted mt-sm">此步骤原图只能下载取回，详情页可复制地址。</text></view></view>
    <text wx:if="{{!steps.length}}" class="small muted">还没有记录做法。</text>
  </view>
  <text class="small muted mt">菜名与封面使用本次点菜快照；做法来自本页首次载入的当前菜谱。</text>
  <view wx:if="{{canClaim || canComplete || canNote}}" class="card mt"><text class="h3">{{canComplete ? '这次做菜成果' : '这次留言'}}</text><voice-note editable="{{true}}" disabled="{{actionBusy}}" mediaId="{{actionVoiceId}}" bindchange="voiceChange" bindbusy="voiceBusy" /><block wx:if="{{canComplete}}"><textarea class="textarea" maxlength="200" placeholder="记录这次的心得（选填）" value="{{completionNote}}" bindinput="completionInput" /><photo-gallery ids="{{photos}}" /><button class="btn-secondary mt-sm" disabled="{{photoBusy || actionBusy || photos.length >= 9}}" loading="{{photoBusy}}" bindtap="choosePhotos">上传成品照片（{{photos.length}}/9）</button><button wx:for="{{photos}}" wx:key="*this" class="btn-text" data-index="{{index}}" bindtap="removePhoto">移除第 {{index+1}} 张</button></block></view>
  <view class="card mt" wx:if="{{item.noteVoiceMediaId || item.claimVoiceMediaId || item.status === 'completed'}}"><text class="h3">本次记录</text><voice-note mediaId="{{item.noteVoiceMediaId}}" /><voice-note mediaId="{{item.claimVoiceMediaId}}" /><block wx:if="{{item.status === 'completed'}}"><text>{{item.completionNote}}</text><review-time labelPrefix="完成于" value="{{item.completedAt}}" /><voice-note mediaId="{{item.completionVoiceMediaId}}" /><photo-gallery ids="{{item.photoMediaIds}}" /></block></view>
  <view class="actions">
    <button wx:if="{{canClaim}}" class="btn-primary" disabled="{{voiceBusy || actionBusy}}" bindtap="claim">我要做</button>
    <button wx:if="{{canComplete}}" class="btn-primary" disabled="{{voiceBusy || photoBusy || actionBusy}}" loading="{{actionBusy}}" bindtap="complete">做好了</button>
    <button wx:if="{{canUnclaim}}" class="btn-secondary" bindtap="unclaim">取消认领</button>
    <button wx:if="{{canNote}}" class="btn-secondary" bindtap="editNote">编辑本次备注</button>
    <button wx:if="{{canCancel}}" class="btn-danger" bindtap="cancel">{{item.status === 'cooking' ? '不做了' : '取消这次点菜'}}</button>
    <button wx:if="{{canReview}}" class="btn-primary" bindtap="review">评价这道菜</button>
    <view wx:if="{{myReview}}" class="note">你已提交这道菜在 {{item.menuDate}} 的评价；评价提交后不能修改。</view>
    <button wx:if="{{item.status === 'cancelled'}}" class="btn-secondary" disabled="{{!canRepeat}}" bindtap="repeatOne">{{canRepeat ? '另行点一次' : '这道菜目前不可点'}}</button>
  </view>
  <view wx:if="{{item.status === 'completed'}}"><view class="section-head"><text class="h2">{{item.menuDate}} 的当日评价</text></view><view class="stack"><view wx:for="{{reviews}}" wx:key="id" class="card"><view class="row between"><text class="small" style="font-weight:700">{{item.memberName}}</text><text class="rating">{{item.starText}}</text></view><review-time value="{{item.createdAt}}" menuDate="{{item.reviewDate}}" /><voice-note mediaId="{{item.voiceMediaId}}" /><text class="review-card-text">{{item.comment || '只留下了评分'}}</text></view><empty-state wx:if="{{!reviews.length}}" title="还没有评价" description="每位启用成员对同一道菜每天可以评价一次，提交后不能修改。" /></view></view>
</view>
<view wx:else class="page"><view class="loading"><view class="spinner"></view></view></view>
