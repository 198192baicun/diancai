<view class="page {{draftCount ? 'with-checkout' : ''}}">
  <app-header avatarId="{{avatarId}}" familyName="{{familyName}}" today="{{today}}" memberName="{{memberName}}" bindmember="switchMember" />
  <text class="h1">家里的拿手菜</text><text class="subtitle">想吃哪一道，就加到已选菜品里。</text>
  <button class="btn-secondary mt" bindtap="random">不知道吃什么？随机选菜</button>
  <view class="search"><text class="search-icon">⌕</text><input value="{{q}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="searchNow" placeholder="搜索菜名" /></view>
  <picker class="category-picker" mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="categoryChange">
    <view class="category-select">
      <view class="grow">
        <text class="category-label">菜品分类</text>
        <text class="category-value">{{categoryNames[categoryIndex] || '全部分类'}}</text>
      </view>
      <text class="category-arrow">⌄</text>
    </view>
  </picker>
  <view class="stack">
    <view wx:for="{{dishes}}" wx:key="id" class="card dish-row {{item.selectedCount ? 'selected' : ''}}">
      <view class="row grow" data-id="{{item.id}}" bindtap="openDish"><food-thumb tone="{{item.tone}}" src="{{item.coverURL}}" /><view class="grow"><text class="h3">{{item.name}}</text><text class="small muted">{{item.categoryName}}{{item.estimatedMinutes ? ' · ' + item.estimatedMinutes + ' 分钟' : ''}}</text><text class="small muted">{{item.ratingText}}{{item.selectedCount ? ' · 已选 ' + item.selectedCount + ' 份' : ''}}</text></view></view>
      <view class="quantity {{item.selectedCount ? 'selected' : ''}}"><text wx:if="{{item.selectedCount}}" class="small muted quantity-label">每份可分别备注</text><button wx:if="{{item.selectedCount}}" class="btn-sub" data-id="{{item.id}}" catchtap="removeDish">−</button><text wx:if="{{item.selectedCount}}">{{item.selectedCount}}</text><button class="btn-add" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="addDish" aria-label="添加{{item.name}}">＋</button></view>
    </view>
    <empty-state wx:if="{{!loading && !dishes.length}}" title="没有找到合适的菜" description="可以换个关键词，或去公共菜品管理新建一道菜。"><button class="btn-secondary mt" bindtap="manage">管理菜品</button></empty-state>
    <view wx:if="{{loading}}" class="loading"><view class="spinner"></view></view>
    <text wx:if="{{!loading && !nextCursor && dishes.length}}" class="small muted center">已经到底了</text>
  </view>
  <button wx:if="{{draftCount}}" class="checkout" bindtap="openDraft"><view><text class="checkout-title">{{pending ? '提交结果尚未确认' : '已选 ' + draftCount + ' 道'}}</text><text class="checkout-desc">{{memberName}}的本机草稿</text></view><text class="checkout-go">去确认 →</text></button>
</view>
