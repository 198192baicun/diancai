<view class="voice" wx:if="{{editable || mediaId}}"><button wx:if="{{mediaId}}" catchtap="play">{{playing ? '■ 停止播放' : '▶ 播放语音'}}</button><button wx:if="{{editable}}" disabled="{{disabled || busy}}" catchtap="record">{{busy ? '上传中…' : recording ? '■ 结束录音' : mediaId ? '重新录制' : '🎙 语音留言'}}</button><button wx:if="{{editable && mediaId}}" disabled="{{disabled || busy || recording}}" catchtap="remove">移除</button><text wx:if="{{recording}}">最长 60 秒，点击结束保存</text><text wx:if="{{error}}">{{error}}</text></view>