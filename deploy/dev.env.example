# Development Compose only; copy to deploy/dev.env and use --env-file explicitly.
# Default is local-machine access. For phone integration, set the Linux host's
# actual trusted LAN IPv4 address. Never use a public IP or 0.0.0.0 here.
DIANCAI_BIND_IP=127.0.0.1
DIANCAI_PORT=3000
# Local build tag, not a published Docker Hub/GHCR image.
DIANCAI_DEV_IMAGE=diancai-dev:local
